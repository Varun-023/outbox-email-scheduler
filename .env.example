# OutBox Email Scheduler — environment template
#
# Copy to `.env` (git-ignored) and fill in the blanks. The same file is read by
# Docker Compose and by the backend (node --env-file). Node does not expand
# ${VARS}, so DATABASE_URL / REDIS_URL must repeat the passwords set below.
#
# Generate a secret:   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Generate ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Browser-facing origin (Vite dev server over HTTPS; it proxies /api and /admin).
APP_ORIGIN=https://localhost:5173
API_PORT=4000
# Number of reverse-proxy hops to trust for X-Forwarded-* (the Vite dev proxy).
TRUST_PROXY=1

# ── MySQL (Docker Compose) ───────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=outbox
MYSQL_USER=outbox
MYSQL_PASSWORD=
# Host port for the container; use e.g. 3307 if a local MySQL already listens on 3306.
MYSQL_HOST_PORT=3306
DATABASE_URL=mysql://outbox:<MYSQL_PASSWORD>@127.0.0.1:3306/outbox
# Created automatically by docker/mysql/init on first start.
DATABASE_URL_TEST=mysql://outbox:<MYSQL_PASSWORD>@127.0.0.1:3306/outbox_test
DB_POOL_SIZE=10

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_HOST_PORT=6379
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0
REDIS_URL_TEST=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/1
BULLMQ_PREFIX=outbox

# ── Elasticsearch ────────────────────────────────────────────────────────────
ES_HOST_PORT=9200
ELASTICSEARCH_URL=http://127.0.0.1:9200
ES_INDEX_PREFIX=outbox

# ── Security ─────────────────────────────────────────────────────────────────
# At least 32 random characters.
SESSION_SECRET=
# Base64-encoded 32 random bytes (AES-256-GCM for SMTP passwords and Slack secrets).
ENCRYPTION_KEY=
# Comma-separated Google account emails allowed to open Bull Board.
ADMIN_EMAILS=
BULL_BOARD_READ_ONLY=false

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:5173/api/auth/google/callback

# ── Slack OAuth ──────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://localhost:5173/api/integrations/slack/callback

# ── Senders / SMTP (Ethereal) ────────────────────────────────────────────────
# Ethereal accounts created automatically for a user with no senders (0 disables).
AUTO_PROVISION_SENDERS=2
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
MESSAGE_ID_DOMAIN=outbox.local

# ── Scheduling, throughput and rate limiting ─────────────────────────────────
EMAIL_WORKER_CONCURRENCY=5
EMAIL_JOB_ATTEMPTS=5
EMAIL_JOB_BACKOFF_MS=15000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Minimum gap between two sends from the same sender.
MIN_DELAY_BETWEEN_EMAILS_MS=2000
RATE_LIMIT_WINDOW_MS=3600000
MAX_RECIPIENTS_PER_CAMPAIGN=5000
MAX_SCHEDULE_AHEAD_DAYS=90
SEND_LEASE_MS=90000

# ── Recovery and lifecycle ───────────────────────────────────────────────────
# fail = never resend when delivery is uncertain; resend = at-least-once.
UNCERTAIN_DELIVERY_POLICY=fail
# 0 = reconcile only at worker startup.
RECONCILE_INTERVAL_MS=60000
SHUTDOWN_GRACE_MS=25000

# ── Tests only ───────────────────────────────────────────────────────────────
# Crash-injection point for failure-scenario tests; ignored unless NODE_ENV=test.
FAULT_POINT=
