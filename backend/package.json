{
  "name": "@outbox/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OutBox API server and BullMQ workers",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../.env src/worker.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "start:worker": "node --env-file-if-exists=../.env dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=../.env scripts/db-reset.ts",
    "sender:create": "tsx --env-file-if-exists=../.env scripts/sender-create.ts",
    "sender:list": "tsx --env-file-if-exists=../.env scripts/sender-list.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.20.4",
    "@types/sanitize-html": "^2.16.1",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "smtp-server": "^3.19.13",
    "supertest": "^7.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.1",
    "@bull-board/express": "^9.10.1",
    "@elastic/elasticsearch": "^8.19.2",
    "@outbox/shared": "^0.1.0",
    "bullmq": "^6.3.9",
    "connect-redis": "^7.1.1",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.1.0",
    "html-to-text": "^10.0.1",
    "ioredis": "^5.11.1",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.17.7",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  }
}
